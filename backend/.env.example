DATABASE_URL=postgresql://shelf:shelf@localhost:5432/sf_fantasy_shelf
PORT=3000
NODE_ENV=development

# Auth (required)
JWT_SECRET=change_me_to_a_long_random_string
INVITE_CODE=change_me

# Anthropic Claude (optional — enables AI summaries, recommendations, series detection)
ANTHROPIC_API_KEY=sk-ant-...

# Google Books (optional — falls back to OpenLibrary for search/series population if unset)
GOOGLE_BOOKS_API_KEY=

# Cloudflare R2 (optional — cover image storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=sf-fantasy-shelf
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Resend email (optional — approval requests, welcome emails, password resets)
RESEND_API_KEY=
ADMIN_EMAIL=
FROM_EMAIL=onboarding@resend.dev
APP_URL=http://localhost:4200
